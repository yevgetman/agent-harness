  "files": [
    "scripts/decisions.mjs",
    "scripts/distribution.mjs",
    "scripts/doctor.mjs",
    "scripts/harness.mjs",
    "scripts/init.mjs",
    "scripts/invariants.mjs",
    "scripts/lock.mjs",
    "scripts/metadata.mjs",
    "scripts/modules.mjs",
    "scripts/plans.mjs",
    "scripts/profiles.mjs",
    "scripts/questions.mjs",
    "scripts/state.mjs",
    "scripts/upgrade.mjs",
    "modules/",
    "profiles/",
    "docs/install.md",
    "docs/minimal-profile.md",
    "docs/v1-validation.md",
    "design/v1-distribution-readiness-design.md"
  ],
  "scripts": {
    "doctor": "node scripts/harness.mjs doctor",
    "init": "node scripts/harness.mjs init",
