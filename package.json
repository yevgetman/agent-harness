{
  "name": "portable-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable agent harness infrastructure",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yevgetman/agent-harness.git"
  },
