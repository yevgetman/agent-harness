    "plans:report": "node scripts/harness.mjs plans report",
    "distribution:check": "node scripts/harness.mjs distribution check",
    "distribution:release-plan": "node scripts/harness.mjs distribution release --plan",
    "distribution:publish-plan": "node scripts/harness.mjs distribution publish --plan",
