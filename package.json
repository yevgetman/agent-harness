    "metadata:list": "node scripts/harness.mjs metadata list",
    "metadata:check": "node scripts/harness.mjs metadata check",
    "metadata:report": "node scripts/harness.mjs metadata report",
    "state:list": "node scripts/harness.mjs state list",
